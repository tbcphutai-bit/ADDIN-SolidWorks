<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType><AssemblyName>NativeToolLibrary.Validation</AssemblyName>
    <StartupObject>ToolLibraryProgram</StartupObject><TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion><PlatformTarget>x64</PlatformTarget><DefineConstants>DEBUG;TRACE</DefineConstants>
    <OutputPath>bin\native\</OutputPath>
    <SolidWorksInteropDirectory Condition="'$(SolidWorksInteropDirectory)' == ''">$(USERPROFILE)\Downloads</SolidWorksInteropDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Drawing"/>
    <Reference Include="System.Windows.Forms"/><Reference Include="System.Web.Extensions"/>
    <Reference Include="SolidWorks.Interop.sldworks"><HintPath>$(SolidWorksInteropDirectory)\SolidWorks.Interop.sldworks.dll</HintPath></Reference>
    <Reference Include="SolidWorks.Interop.swconst"><HintPath>$(SolidWorksInteropDirectory)\SolidWorks.Interop.swconst.dll</HintPath></Reference>
    <Compile Include="..\BendPlanning\NativePlanningValidation.cs"><Link>NativePlanningValidation.cs</Link></Compile>
    <Compile Include="NativeToolLibraryValidation.cs"/>
    <Compile Include="NativeTestProcess.cs"/>
    <Compile Include="NativeSnapshotJson.cs"/>
    <Compile Include="NativeFamilyReference.cs"/>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
