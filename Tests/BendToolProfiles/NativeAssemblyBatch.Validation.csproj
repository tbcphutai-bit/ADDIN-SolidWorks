    <Reference Include="SolidWorks.Interop.sldworks"><HintPath>$(SolidWorksInteropDirectory)\SolidWorks.Interop.sldworks.dll</HintPath></Reference>
    <Reference Include="SolidWorks.Interop.swconst"><HintPath>$(SolidWorksInteropDirectory)\SolidWorks.Interop.swconst.dll</HintPath></Reference>
    <Compile Include="NativeAssemblyBatchValidation.cs"/>
    <Compile Include="NativeAssemblyBatchEdges.cs"/>
    <Compile Include="NativeAssemblyMixedTests.cs"/>
    <Compile Include="NativeTestProcess.cs"/>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
