+        private static void AuditCg21Coverage(Metrics m, string modelName)
+        {
+            if (m == null || !m.HasCg2)
+                throw new InvalidOperationException("CG2 report missing: " + modelName);
+
+            Console.WriteLine("  CG2_COUNTS model=" + modelName +
+                " Total=" + m.Cg2TotalOccurrences +
+                " EligibleParts=" + m.Cg2EligibleComponents +
+                " Bounds=" + m.Cg2Bounds +
+                " SubassemblyContainers=" + m.Cg2SubassemblyContainers +
+                " UnresolvedParts=" + m.Cg2UnresolvedLeafParts +
+                " Skipped=" + m.Cg2SkippedOrUnreadable);
+            bool consistent = m.Cg2TotalOccurrences >= 0 &&
+                m.Cg2EligibleComponents >= 0 && m.Cg2Bounds >= 0 &&
+                m.Cg2SubassemblyContainers >= 0 &&
+                m.Cg2UnresolvedLeafParts >= 0 && m.Cg2SkippedOrUnreadable >= 0 &&
+                m.Cg2Bounds <= m.Cg2EligibleComponents &&
+                m.Cg2UnresolvedLeafParts <= m.Cg2SkippedOrUnreadable &&
+                (long)m.Cg2EligibleComponents + m.Cg2SubassemblyContainers
+                    <= m.Cg2TotalOccurrences;
+            if (!consistent)
+                throw new InvalidOperationException("CG2_COUNT_INCONSISTENT: " + modelName);
+            Console.WriteLine("  CG2_COUNT_AUDIT=PASS");
+            if (string.Equals(m.Cg2CoverageStatus, "PARTIAL_UNVERIFIED",
+                StringComparison.Ordinal))
+            {
+                Console.WriteLine("  CG2_PARTIAL_REASON Skipped=" +
+                    m.Cg2SkippedOrUnreadable + " IsPartial=" + m.Cg2IsPartial +
+                    " Bounds=" + m.Cg2Bounds);
+                foreach (string warning in m.Cg2Warnings.Take(5))
+                    Console.WriteLine("  CG2_WARNING=" + warning);
+            }
+        }
+
